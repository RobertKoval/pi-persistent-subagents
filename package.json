{
  "name": "pi-persistent-subagents",
  "version": "0.2.0",
  "description": "Persistent worker agents for Pi: spawn, steer, reuse and resume live RPC sessions.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "subagents",
    "multi-agent",
    "rpc"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:core": "node --experimental-strip-types --test test/rpc-client.test.ts test/config-selection.test.ts test/registry.test.ts test/pool.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "diagnose": "node scripts/diagnose.mjs",
    "test:e2e": "PI_PERSISTENT_SUBAGENTS_E2E=1 node --experimental-strip-types --test test/live-e2e.test.ts",
    "test:live": "node scripts/local-acceptance.mjs",
    "test:lifecycle": "node scripts/local-acceptance.mjs SIGTERM && node scripts/local-acceptance.mjs SIGHUP && node scripts/local-acceptance.mjs SIGKILL",
    "test:live:manager": "node scripts/local-acceptance.mjs --manager",
    "test:live:streaming": "node scripts/local-acceptance.mjs --streaming",
    "test:live:cache": "node scripts/local-acceptance.mjs --cache",
    "test:live:shutdown": "node scripts/local-acceptance.mjs --shutdown-work SIGTERM && node scripts/local-acceptance.mjs --shutdown-work SIGHUP && node scripts/local-acceptance.mjs --shutdown-work SIGKILL"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.0",
    "typebox": "^1.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^22.19.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "scripts",
    "test",
    "docs",
    "assets",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "author": "Robert Koval",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobertKoval/pi-persistent-subagents.git"
  },
  "homepage": "https://github.com/RobertKoval/pi-persistent-subagents#readme",
  "bugs": {
    "url": "https://github.com/RobertKoval/pi-persistent-subagents/issues"
  },
  "dependencies": {
    "@toon-format/toon": "4.1.1"
  }
}
